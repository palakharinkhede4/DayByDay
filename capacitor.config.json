{
  "appId": "com.daybyday.habittracker",
  "appName": "DayByDay",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0d1b1e"
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_flame",
      "iconColor": "#F97316",
      "sound": "beep.wav"
    }
  }
}
